{
	"name": "homeport",
	"version": "1.0.0",
	"license": "Apache-2.0",
	"description": "Homeport — the self-hostable NANDA node. Agent registry, trust, federation, and protocol switchboard on Cloudflare Workers.",
	"private": true,
	"type": "module",
	"bin": {
		"homeport": "./bin/homeport.mjs"
	},
	"scripts": {
		"start": "node bin/homeport.mjs run",
		"dev": "vite dev",
		"build": "vite build && node scripts/inject-cache-shim.js && node scripts/inject-scheduled-handler.js",
		"preview": "vite preview",
		"deploy:dev": "pnpm run build && npx wrangler deploy --env dev",
		"deploy:test": "pnpm run build && npx wrangler deploy --env test",
		"deploy:testnet": "pnpm run build && npx wrangler deploy --env testnet",
		"deploy:prod": "pnpm run build && npx wrangler deploy --env prod",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"pretest": "vite build && node scripts/inject-cache-shim.js && node scripts/inject-scheduled-handler.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"validate": "pnpm run lint && pnpm run check && pnpm run test",
		"db:generate": "drizzle-kit generate",
		"db:migrate:dev": "npx wrangler d1 migrations apply homeport-db-dev --env dev --remote",
		"db:migrate:testnet": "npx wrangler d1 migrations apply homeport-db-testnet --env testnet --remote",
		"db:migrate:prod": "npx wrangler d1 migrations apply homeport-db --env prod --remote",
		"db:studio": "drizzle-kit studio",
		"setup": "node scripts/setup.js",
		"test:e2e": "playwright test",
		"db:migrate": "drizzle-kit migrate"
	},
	"pnpm": {
		"overrides": {
			"cookie": "^0.7.0",
			"js-yaml": "^4.2.0",
			"undici": "7.28.0",
			"rollup": "^4.59.0",
			"minimatch": "^9.0.7",
			"devalue": "5.8.1",
			"ws": "8.21.0",
			"esbuild": "0.28.1",
			"brace-expansion": "2.0.3",
			"picomatch": "4.0.4",
			"flatted": "3.4.2",
			"yaml": "1.10.3",
			"postcss": "8.5.10"
		},
		"onlyBuiltDependencies": [
			"better-sqlite3",
			"esbuild",
			"sharp",
			"svelte-preprocess",
			"workerd"
		]
	},
	"packageManager": "pnpm@10.28.1",
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.12.21",
		"@cloudflare/workers-types": "^4.20260619.1",
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@playwright/test": "1.61.0",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.66.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/howler": "^2.2.12",
		"@types/qrcode": "^1.5.6",
		"@vitest/runner": "^3.2.6",
		"@vitest/snapshot": "^3.2.6",
		"autoprefixer": "^10.4.24",
		"drizzle-kit": "^0.31.9",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"png-to-ico": "^3.0.1",
		"postcss": "^8.5.6",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.0",
		"satori": "^0.19.2",
		"svelte": "^5.55.7",
		"svelte-check": "^4.4.3",
		"sveltekit-openapi-generator": "^0.1.5",
		"swagger-ui-dist": "^5.31.2",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"vite": "^7.3.5",
		"vitest": "^3.2.6",
		"wrangler": "^4.103.0"
	},
	"dependencies": {
		"@fontsource-variable/inter": "5.2.8",
		"@fontsource-variable/jetbrains-mono": "5.2.8",
		"@nexartis/owner-preferences": "^1.0.1",
		"@nexartis/sentinel-sdk": "^1.6.0",
		"@noble/curves": "^1.9.7",
		"@noble/hashes": "^1.8.0",
		"@xyflow/svelte": "^1.5.1",
		"better-sqlite3": "^11.0.0",
		"bits-ui": "^2.16.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"howler": "^2.2.4",
		"lucide-svelte": "^0.575.0",
		"mode-watcher": "^1.1.0",
		"nanoid": "^5.1.6",
		"qrcode": "^1.5.4",
		"svelte-grid-extended": "^1.2.1",
		"tailwind-merge": "^3.5.0",
		"zod": "^4.4.3"
	},
	"engines": {
		"node": ">=20.19.0",
		"pnpm": ">=10.0.0"
	}
}
