{
	// Homeport — Cubicube Core Cubi Manifest
	// Pegasus reads this during deployment to provision infrastructure.
	// The `setup` script also reads this for self-hosted provisioning.

	"manifestVersion": 1,

	"name": "homeport",
	"displayName": "NANDA Node",
	"version": "1.0.0",
	"description": "Self-contained trust, discovery, and orchestration node for the NANDA agent network. Provides agent registration, certification, compliance, reputation, credential issuance, decentralized discovery, and multi-agent orchestration.",

	// Top-level framework (compliance-floor canonical shape). Kept in `stack`
	// as well for backward compatibility with older Pegasus versions that
	// still read `stack.framework`.
	"framework": "sveltekit",

	// Template classification
	"category": "infrastructure",
	"tags": ["nanda", "agent-network", "trust", "federation", "orchestration", "mcp"],

	// SDK dependencies — cubes this template consumes as libraries
	"requiredCubes": ["cube-sentinel-v1"],

	// Stack declaration
	"stack": {
		"framework": "sveltekit",
		"runtime": "cloudflare-workers",
		"language": "typescript"
	},

	// Required Cloudflare bindings. D1/R2/KV are provisioned by Pegasus; Secrets
	// Store entries listed below must already exist in the shared Secrets Store
	// until generated-secret provisioning is implemented as a Pegasus capability.
	"requiredBindings": {
		"d1": ["DB"],
		"r2": ["KYM_NANDA_EVIDENCE"],
		"kv": ["NANDA_NODE_CACHE"],
		"secrets_store": [
			"KYM_NANDA_HMAC_SECRET",
			"KYM_NANDA_RADIUS_SECRET",
			"KYM_NANDA_ED25519_PRIVATE_KEY_v1",
			"CRON_AUTH_TOKEN",
			"NANDA_FEDERATION_ADMIN_KEY",
			"RESEND_API_KEY"
		],
		// NANDA_REGISTRY_URL and VITE_BASE_URL are deploy-time injected by the
		// Pegasus engine (deploy-driver, sourced from WORKER_URL). Not listed
		// here — the deploy-driver fails loudly if the wrangler declaration is
		// present but WORKER_URL is missing.
		"vars": ["ENVIRONMENT", "LOG_LEVEL", "NANDA_NODE_ID", "SENTINEL_API_URL"]
		// Intentionally NOT required-at-deploy (see requiredVars below):
		//   NANDA_ED25519_PUBLIC_KEY_v1 — generated by the tenant worker on
		//     first boot; resolvePublicKey() falls back to KV (see
		//     src/lib/utils/node-secrets.ts). Empty at deploy time is correct
		//     for both Nexartis-hosted and operator-hosted nodes.
		//   NANDA_FEDERATION_PEER_URL — post-deploy operator config; already
		//     typed `?: string` in src/app.d.ts and src/lib/types.ts. Empty
		//     means "no federation peer configured", which every consuming
		//     route handles explicitly.
		// Listing them in requiredBindings.vars had Pegasus's post-provision
		// validator flag them as "unresolved ()" — every prod nanda deploy
		// (nodeone-nodefour, ensenadabeach, sheridee) hit the same error
		// pre-f8d337a and shipped anyway because `tee` masked the exit code.
		// f8d337a correctly closed the silent-success hole (pipefail), which
		// unmasked this pre-existing template bug on dev run 28706021046.
	},

	// Tenant-URL vars beyond the universal VITE_BASE_URL: deploy-driver
	// injects each from WORKER_URL (the actual deployed hostname) at deploy
	// time. Opt-in also requires the key declared "" in the tenant's
	// deployment env vars block of wrangler.jsonc.
	// NANDA_REGISTRY_URL: DID web base, VC issuer/status URLs, .well-known
	// endpoints, federation join self-reference.
	"tenantUrlVars": ["NANDA_REGISTRY_URL"],

	// ===================================================================
	// Required Variables — default values for Pegasus provisionVars()
	// ===================================================================
	// Pegasus reads this to set initial environment variables for new deployments.
	// Values marked __PEGASUS_PROVISION__ are replaced at deploy time.
	// Empty-string entries below are post-deploy operator configuration
	// (see requiredBindings.vars comment) — documented here so provisionVars()
	// still writes them into wrangler.jsonc but the post-provision validator
	// no longer enforces them.
	"requiredVars": {
		"ENVIRONMENT": "production",
		"LOG_LEVEL": "warn",
		"NANDA_NODE_ID": "__PEGASUS_PROVISION__",
		"NANDA_ED25519_PUBLIC_KEY_v1": "",
		"NANDA_FEDERATION_PEER_URL": "",
		"SENTINEL_API_URL": "__PEGASUS_PROVISION__",
		"SITE_OWNER_EMAIL": "__PEGASUS_PROVISION__",
		"SITE_NAME": "__PEGASUS_PROVISION__",
		"CONTACT_EMAIL_TO": "__PEGASUS_PROVISION__",
		"FROM_EMAIL": "__PEGASUS_PROVISION__",
		"NODE_ENV": "production",
		"PAYMENT_PAYEE": "service",
		"CERT_VALIDITY_DAYS": "90",
		"CERT_PASS_THRESHOLD": "0.8",
		"NP_TO_USD_RATE": "0.001",
		"EUR_TO_USD_RATE": "1.08"
	},

	// ===================================================================
	// Binding Configuration — resource provisioning details
	// ===================================================================
	// Template-level bindings injected by Pegasus provisionTemplateBindings().
	// All NANDA node resources are per-deployment (no shared resources).
	//
	// Resource naming convention:
	//   Entries with *_template fields signal PER-DEPLOYMENT resource creation.
	//   The template variable {workerName} is resolved from cubicube.json at
	//   deploy time (the Cloudflare Worker name, e.g., "acme-nanda").
	//
	//   Examples for workerName = "acme-nanda":
	//     D1:  acme-nanda-db
	//     R2:  acme-nanda-evidence
	//     KV:  acme-nanda-cache
	//
	// Entries with hardcoded IDs (e.g., "id": "2cb2ddff...") reference SHARED
	// resources — not applicable for NANDA node but used by showrunner-cubi.
	"bindingConfig": {
		"d1_databases": [
			{
				"binding": "DB",
				"database_name_template": "{workerName}-db",
				"migrations_dir": "drizzle/migrations"
			}
		],
		"r2_buckets": [
			{
				"binding": "KYM_NANDA_EVIDENCE",
				"bucket_name_template": "{workerName}-evidence",
				"ownership": "site"
			}
		],
		"kv_namespaces": [
			{
				"binding": "NANDA_NODE_CACHE",
				"namespace_name_template": "{workerName}-cache"
			}
		],
		"secrets_store_secrets": [
			{
				"binding": "KYM_NANDA_HMAC_SECRET",
				"store_id": "__PEGASUS_PROVISION__",
				"secret_name": "KYM_NANDA_HMAC_SECRET"
			},
			{
				"binding": "KYM_NANDA_RADIUS_SECRET",
				"store_id": "__PEGASUS_PROVISION__",
				"secret_name": "KYM_NANDA_RADIUS_SECRET"
			},
			{
				"binding": "KYM_NANDA_ED25519_PRIVATE_KEY_v1",
				"store_id": "__PEGASUS_PROVISION__",
				"secret_name": "KYM_NANDA_ED25519_PRIVATE_KEY_v1"
			},
			{
				"binding": "CRON_AUTH_TOKEN",
				"store_id": "__PEGASUS_PROVISION__",
				"secret_name": "KYM_CRON_AUTH_TOKEN"
			},
			{
				"binding": "NANDA_FEDERATION_ADMIN_KEY",
				"store_id": "__PEGASUS_PROVISION__",
				"secret_name": "KYM_NANDA_FEDERATION_ADMIN_KEY"
			}
		],
		"crons": ["0 * * * *"]
	},
	"lifecycleStatus": "no-effect-required",
	"lifecycleEffects": [],

	// Database schema
	"database": {
		"tables": 53,
		"domains": 21,
		"migrations": "drizzle/migrations",
		"schema": "src/lib/db/schema.ts"
	},

	// Features provided by this node
	"features": [
		"agent-registry",
		"agent-certification",
		"compliance-engine",
		"reputation-scoring",
		"credential-issuance",
		"lean-index-dns",
		"federation-gossip",
		"multi-agent-orchestration",
		"mcp-server",
		"a2a-protocol",
		"ucp-checkout",
		"billing-metering",
		"webhook-delivery"
	],

	// Structural preservation — paths that must not be modified during deployment
	"protectedPaths": [
		"src/lib/db/",
		"src/lib/services/",
		"src/lib/middleware/",
		"src/lib/utils/",
		"src/lib/mcp/",
		"src/routes/a2a/",
		"src/routes/api/",
		"src/routes/federation/",
		"src/routes/mcp/",
		"src/routes/.well-known/",
		"wrangler.jsonc",
		"cube.jsonc",
		"drizzle/",
		"eslint.config.js",
		"svelte.config.js",
		"vite.config.ts",
		"tsconfig.json",
		"scripts/setup-cubicube.sh",
		"scripts/patch-wrangler-vars.cjs",
		".mcp.json"
	]
}
